// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  passwordHash       String
  reminderDaysBefore Int      @default(3)
  createdAt          DateTime @default(now())

  bankAccounts         BankAccount[]
  creditCards          CreditCard[]
  loans                Loan[]
  mutualFunds          MutualFund[]
  debts                Debt[]
  transactions         Transaction[]
  pushSubscriptions    PushSubscription[]
  sentReminders        SentReminder[]
  budgets              Budget[]
  goals                Goal[]
  creditCardStatements CreditCardStatement[]
  creditCardPayments   CreditCardPayment[]
}

model Goal {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  targetDate    DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  contributions Transaction[]
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Tracks which (item, due date) reminders have already been sent so the
// daily scheduled job never notifies the same upcoming due date twice.
model SentReminder {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String // e.g. "card:<id>:2026-09-10"
  sentAt DateTime @default(now())

  @@unique([userId, key])
}

model BankAccount {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountName String
  bankName    String
  accountType String // savings, current, salary, nri, other
  last4       String?
  balance     Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goals Goal[]
  autoDebitLoans Loan[]
}

model CreditCard {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardName       String
  bankName       String
  last4          String?
  creditLimit    Float
  currentBalance Float    @default(0)
  statementDay   Int // day of month statement generates
  dueDay         Int // day of month payment is due
  minPayment     Float?
  apr            Float?
  notes          String?
  isActive       Boolean   @default(true)
  nextDueDate    DateTime? // user-set next payment due date - takes priority over dueDay/statement guesses
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statements CreditCardStatement[]
  payments   CreditCardPayment[]
}

// A frozen bill for one billing cycle. statementTotal/minimumDue are set at
// generation (or manual override) and never silently recalculated -
// paidAmount/remainingDue/status are derived from linked payments instead of
// stored, so they can't drift out of sync with reality.
model CreditCardStatement {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId         String
  card           CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  statementDate  DateTime
  dueDate        DateTime
  openingBalance Float
  purchaseTotal  Float
  refundTotal    Float
  feeTotal       Float
  interestTotal  Float
  statementTotal Float
  minimumDue     Float
  isManual       Boolean    @default(false)
  generatedAt    DateTime   @default(now())
  finalizedAt    DateTime?
  notes          String?

  transactions Transaction[]
  payments     CreditCardPayment[]

  @@unique([cardId, periodEnd])
}

// Links a real bank->card transfer (the Transaction that actually moves the
// money) to the statement it settles. Amount/date are read through the
// transaction relation rather than duplicated here, so there's nothing to
// go stale if that transaction is later edited.
model CreditCardPayment {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          CreditCard           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  statementId   String?
  statement     CreditCardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  transactionId String               @unique
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
}

model Loan {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanName          String
  lender            String
  loanType          String // home, car, personal, education, gold, other
  principal         Float
  outstanding       Float
  interestRate      Float?
  emiAmount         Float?
  emiDueDay         Int // day of month EMI is due
  startDate         DateTime?
  tenureMonths      Int?
  notes             String?
  autoDebitAccountId String?
  autoDebitAccount  BankAccount? @relation(fields: [autoDebitAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model MutualFund {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundName      String
  fundHouse     String?
  folioNumber   String?
  category      String? // equity, debt, hybrid, index, other
  units         Float?
  investedValue Float    @default(0)
  currentValue  Float    @default(0)
  sipAmount     Float?
  sipDueDay     Int? // day of month SIP is debited, null if no active SIP
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String // expense, income, transfer
  amount          Float
  date            DateTime
  category        String?
  note            String?
  fromAccountType String? // bank
  fromAccountId   String?
  toAccountType   String? // bank, card, loan, fund
  toAccountId     String?
  goalId          String?
  goal            Goal?                @relation(fields: [goalId], references: [id], onDelete: SetNull)
  cardTxnType     String? // purchase, fee, interest, refund, reversal, cash_withdrawal - inferred if unset
  postedDate      DateTime? // falls back to `date` when absent
  statementId     String? // which credit card statement this charge belongs to, if any
  statement       CreditCardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  cardPayment     CreditCardPayment?
  createdAt       DateTime             @default(now())
}

model Debt {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personName String
  direction  String // owed_by_me, owed_to_me
  amount     Float
  dueDate    DateTime?
  notes      String?
  settled    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
